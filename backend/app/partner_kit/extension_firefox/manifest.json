{
  "manifest_version": 3,
  "name": "Outreach",
  "version": "1.0.0",
  "description": "Find leads, send email, make calls and plan posts from any page, in a side panel. Reads the page only when you click the button.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open Outreach",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "permissions": [
    "storage",
    "identity",
    "activeTab",
    "scripting"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "outreach@aivhub.com",
      "strict_min_version": "121.0"
    }
  },
  "sidebar_action": {
    "default_panel": "sidepanel.html",
    "default_title": "Outreach",
    "default_icon": "icons/icon48.png",
    "open_at_install": false
  }
}
