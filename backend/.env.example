# ==============================================================================
# AIVHub Voice AI - Environment Configuration (.env)
# ==============================================================================

# Public URL of the backend (Critical for Twilio Webhooks & Media Stream)
# - Local dev with ngrok: https://your-tunnel-name.ngrok-free.dev
# - Lightning AI Cloudspace: https://8000-YOUR_SPACE_ID.cloudspaces.litng.ai
# - Production VPS: https://api.yourdomain.com
PUBLIC_BASE_URL=https://8080-YOUR_SPACE_ID.cloudspaces.litng.ai

# Frontend URL (for CORS and redirect links)
FRONTEND_URL=http://localhost:5173

# Database configuration
# For production/server: Use PostgreSQL
# DATABASE_URL=postgresql+asyncpg://user:password@server_ip:5432/aivhub
# For local dev: Use SQLite
DATABASE_URL=postgresql+asyncpg://postgres:postgres_secure_password_2026@localhost:5432/aivhub

# xAI Realtime Voice Agent
XAI_API_KEY=
XAI_VOICE_NAME=rex
XAI_TEMPERATURE=0.80

# Twilio Telephony (Optional here - also auto-saved in Database via UI)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Sipgate Telephony Trunk Configuration
SIPGATE_SIP_ID=4032431t0
SIPGATE_PASSWORD=qURd1qn99mBV
SIPGATE_SERVER=sipconnect.sipgate.co.uk
SIPGATE_PHONE_NUMBER=+445600022627
