# ==============================================================================
# AIVHub Voice AI - Environment Configuration (.env)
# ==============================================================================

# Public URL of the backend (Critical for Twilio/Telnyx Webhooks & Media Streams)
PUBLIC_BASE_URL=https://outreach.aivhub.com
VOICE_ENGINE_MODE=live

# Frontend URL (for CORS and redirect links)
FRONTEND_URL=https://outreach.aivhub.com

# Database configuration (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/aivhub

# Calendar Engine Mode: internal or calcom
CALENDAR_MODE=internal

# Cal.com Integration (Cloud API v2 - optional)
# CALCOM_BASE_URL=https://api.cal.com/v2
# CALCOM_API_KEY=

# xAI Realtime Voice Agent
# XAI_API_KEY=
# XAI_VOICE_NAME=rex
# XAI_TEMPERATURE=0.80

# Twilio Telephony (Optional - also configurable via Web UI)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=

# Telnyx Telephony (Optional)
# TELNYX_API_KEY=
# TELNYX_PHONE_NUMBER=
# TELNYX_CONNECTION_ID=

# Deepgram STT (Optional)
# DEEPGRAM_API_KEY=

# Cartesia TTS (Optional)
# CARTESIA_API_KEY=
