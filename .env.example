# ==============================================================================
# AIVHub Voice AI Agent & Post Scheduler — Environment Configuration
# ==============================================================================

# Database & Cache (Used in Docker Compose)
POSTGRES_DB=aivhub
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password_2026
REDIS_URL=redis://redis:6379/0

# Security
SECRET_KEY=aivhub_production_jwt_secret_key_change_me_in_prod

# Engine Mode: "simulation" (out-of-the-box zero config testing) or "live"
VOICE_ENGINE_MODE=simulation

# Self-Hosted Cal.com Calendar Engine (Open Source AGPLv3)
CALCOM_WEBAPP_URL=http://localhost:3000
NEXTAUTH_SECRET=aivhub_calcom_jwt_secret_token_2026_xyz
CALENDSO_ENCRYPTION_KEY=aivhub_calcom_encryption_key_32b_x
CALCOM_API_KEY=
CALCOM_EVENT_TYPE_ID=

# Telephony & Voice Providers (Optional - populate when connecting live carriers)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Speech-to-Text & Text-to-Speech
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
CARTESIA_API_KEY=
# Your Cartesia clone UUID (xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx)
# With XAI_API_KEY + CARTESIA_API_KEY, live calls use xAI brain/STT + this voice for TTS
CARTESIA_VOICE_ID=

# LLM Providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# Realtime WebRTC / Voice Orchestration
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Public URLs (OAuth callbacks must match the developer-app redirect URI exactly)
PUBLIC_BASE_URL=http://127.0.0.1:8000
FRONTEND_URL=http://localhost:5173
# Optional override for SIP / carrier webhook (defaults to {PUBLIC_BASE_URL}/api/sip-webhook)
XAI_WEBHOOK_URL=

# Social OAuth — AIVHub developer apps (one-time). Users then click Connect and log in.
# Callbacks:
#   {PUBLIC_BASE_URL}/api/scheduler/oauth/x/callback
#   {PUBLIC_BASE_URL}/api/scheduler/oauth/linkedin/callback
#   {PUBLIC_BASE_URL}/api/scheduler/oauth/facebook/callback
#   {PUBLIC_BASE_URL}/api/scheduler/oauth/instagram/callback
#   {PUBLIC_BASE_URL}/api/scheduler/oauth/threads/callback
X_OAUTH_CLIENT_ID=
X_OAUTH_CLIENT_SECRET=
LINKEDIN_OAUTH_CLIENT_ID=
LINKEDIN_OAUTH_CLIENT_SECRET=
FACEBOOK_OAUTH_CLIENT_ID=
FACEBOOK_OAUTH_CLIENT_SECRET=
THREADS_OAUTH_CLIENT_ID=
THREADS_OAUTH_CLIENT_SECRET=
