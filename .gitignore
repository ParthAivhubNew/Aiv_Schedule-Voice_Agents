# Environment variables (.env.local is tracked on purpose: Stripe TEST keys for developers)
.env
.env.development.local
.env.test.local
.env.production.local
.env.bak*
# Every other .env file holds secrets too (.env.backup, .env.new, ...): only the example and the tracked test-keys file are committed.
.env.*
!.env.example
!.env.local

